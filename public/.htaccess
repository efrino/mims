<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /mims
RewriteRule ^mims/index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /mims/index.html [L]
</IfModule>