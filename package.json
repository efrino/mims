{
  "name": "inventory-system-maj",
  "version": "1.2.0",
  "private": false,
  "author": "MAJ-IT",
  "type": "module",
  "tailwindcss": {
    "config": {
      "content": [
        "./index.html",
        "./src/**/*.{vue,js,ts,jsx,tsx}",
        "./node_modules/flowbite/**/*.{js,ts,vue}"
      ],
      "plugins": [
        "flowbite/plugin"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build-stage": "vue-tsc --noEmit && vite build --base=/vue/free/stage/",
    "build-prod": "vue-tsc --noEmit && vite build --base=/vue/free/",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "deploy": "touch dist/.nojekyll && gh-pages -d dist --dotfiles",
    "ssh:setup": "node scripts/run-bash.mjs scripts/setup-ssh.sh",
    "deploy:67": "node scripts/run-bash.mjs scripts/deploy-fe.sh",
    "deploy:67:llbroack": "node scripts/run-bash.mjs scripts/deploy-fe.sh --rollback"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@chenfengyuan/vue-barcode": "^2.0.2",
    "@fontsource/inter": "5.1.0",
    "@fontsource/poppins": "5.1.0",
    "@fontsource/public-sans": "5.1.1",
    "@fontsource/roboto": "5.1.0",
    "@google/model-viewer": "^4.3.1",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@tailwindcss/vite": "^4.1.17",
    "@themesberg/flowbite": "^1.3.0",
    "@tsconfig/node20": "20.1.4",
    "@types/jsrsasign": "^10.5.15",
    "@types/jszip": "^3.4.0",
    "@types/qz-tray": "^2.2.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vueup/vue-quill": "^1.5.5",
    "ant-design-vue": "4.2.6",
    "apexcharts": "^4.3.0",
    "axios": "^1.12.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "flowbite": "^4.0.1",
    "flowbite-datepicker": "^2.0.0",
    "highcharts": "^12.4.0",
    "highcharts-vue": "^2.0.1",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jsrsasign": "^11.1.0",
    "jszip": "^3.10.2",
    "jwt-decode": "^4.0.0",
    "konva": "^10.3.0",
    "markdown-it": "^15.0.2",
    "moment": "^2.30.1",
    "motion-v": "^2.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^2.3.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "qrcode.vue": "^3.6.0",
    "qz-tray": "^2.2.5",
    "simple-datatables": "^10.2.0",
    "socket.io-client": "^2.4.0",
    "tailwindcss": "^4.1.17",
    "vee-validate": "4.15.0",
    "vite-plugin-static-copy": "^3.1.1",
    "vite-plugin-vuetify": "2.0.4",
    "vue": "3.5.13",
    "vue-konva": "^3.4.0",
    "vue-router": "^4.0.13",
    "vue-tabler-icons": "2.21.0",
    "vue3-apexcharts": "^1.8.0",
    "vue3-perfect-scrollbar": "2.0.0",
    "vuetify": "3.7.6",
    "webpack-plugin-vuetify": "3.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/file-saver": "^2.0.7",
    "@types/node": "22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/socket.io-client": "^1.4.36",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/eslint-config-prettier": "10.1.0",
    "@vue/tsconfig": "0.7.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "9.32.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "prettier": "3.4.2",
    "sass": "1.77.1",
    "sass-loader": "16.0.4",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.4.3",
    "vue-cli-plugin-vuetify": "2.5.8",
    "vue-tsc": "2.2.0"
  }
}
